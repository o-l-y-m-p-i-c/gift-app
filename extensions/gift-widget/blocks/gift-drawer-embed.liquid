{% comment %}
  Gift Drawer Embed — App embed that adds the gift widget to the theme's
  cart drawer on themes without app block support in the drawer.

  Enable via: Online Store → Customize → App embeds → Gift Drawer Embed
{% endcomment %}

{% assign cta_choose = block.settings.cta_choose %}
{% if cta_choose == blank %}{% assign cta_choose = 'gift.drawer.cta_choose' | t %}{% endif %}
{% assign cta_more = block.settings.cta_more %}
{% if cta_more == blank %}{% assign cta_more = 'gift.drawer.cta_more' | t %}{% endif %}
{% assign cta_manage = block.settings.cta_manage %}
{% if cta_manage == blank %}{% assign cta_manage = 'gift.drawer.cta_manage' | t %}{% endif %}
{% assign label_unlock = block.settings.label_unlock %}
{% if label_unlock == blank %}{% assign label_unlock = 'gift.drawer.label_unlock' | t %}{% endif %}
{% assign label_unlocked = block.settings.label_unlocked %}
{% if label_unlocked == blank %}{% assign label_unlocked = 'gift.drawer.label_unlocked' | t %}{% endif %}
{% assign label_used = block.settings.label_used %}
{% if label_used == blank %}{% assign label_used = 'gift.drawer.label_used' | t %}{% endif %}
{% assign label_full = block.settings.label_full %}
{% if label_full == blank %}{% assign label_full = 'gift.drawer.label_full' | t %}{% endif %}
{% assign promo_title = block.settings.promo_title %}
{% if promo_title == blank %}{% assign promo_title = 'gift.promo_title' | t %}{% endif %}

{%- capture gift_style -%}
  --gift-accent: {{ block.settings.accent_color | default: '#1c1c1c' }};
  --gift-accent-text: {{ block.settings.accent_text_color | default: '#ffffff' }};
  --gift-corner-radius: {{ block.settings.corner_radius | default: 12 }}px;
  --gift-custom-container-radius: {{ block.settings.container_radius | default: 12 }}px;
  --gift-custom-border-width: {{ block.settings.border_width | default: 1 }}px;
  --gift-padding-scale: {{ block.settings.padding | default: '1.25' }};
  --gift-custom-spacing: {{ block.settings.spacing | default: 16 }}px;
  --gift-title-scale: {{ block.settings.title_size | default: '0.9375' }};
  --gift-custom-title-transform: {% if block.settings.title_uppercase == false %}none{% else %}uppercase{% endif %};
  {%- if block.settings.background_color != blank %} --gift-custom-bg: {{ block.settings.background_color }};{% endif -%}
  {%- if block.settings.border_transparent %} --gift-custom-border: transparent;{% elsif block.settings.border_color != blank %} --gift-custom-border: {{ block.settings.border_color }};{% endif -%}
  {%- if block.settings.card_background_color != blank %} --gift-surface: {{ block.settings.card_background_color }};{% endif -%}
  {%- if block.settings.progress_color != blank %} --gift-custom-progress: {{ block.settings.progress_color }};{% endif -%}
  {%- if block.settings.highlight_color != blank %} --gift-custom-highlight: {{ block.settings.highlight_color }};{% endif -%}
  {%- if block.settings.text_color != blank %} color: {{ block.settings.text_color }};{% endif -%}
{%- endcapture -%}
{%- comment -%}
  Shared app attributes are written out here rather than rendered from a
  snippet: Shopify wraps app snippet output in HTML comments, which would
  close this tag early and print the attributes as text.
{%- endcomment -%}
<div id="gift-drawer-{{ block.id }}"
     data-gift-drawer-widget
     data-gift-embed-mode="true"
     data-show-remaining="{{ block.settings.show_remaining }}"
     data-redirect-checkout="{{ block.settings.redirect_checkout }}"
     data-product-preview="{{ block.settings.product_preview | default: 'disabled' }}"
     data-drawer-selector="{{ block.settings.drawer_selector | escape }}"
     data-drawer-position="{{ block.settings.drawer_position | default: 'top' }}"
     data-cta-choose="{{ cta_choose | escape }}"
     data-cta-more="{{ cta_more | escape }}"
     data-cta-manage="{{ cta_manage | escape }}"
     data-label-unlock="{{ label_unlock | escape }}"
     data-label-unlocked="{{ label_unlocked | escape }}"
     data-label-used="{{ label_used | escape }}"
     data-label-full="{{ label_full | escape }}"
     data-gift-app
     data-shop="{{ shop.permanent_domain }}"
     data-shop-currency="{{ shop.currency }}"
     data-money-format="{{ shop.money_format | escape }}"
     data-proxy-path="{{ block.settings.proxy_path | default: '/apps/gift-threshold' | escape }}"
     data-refresh-mode="{{ block.settings.refresh_mode | default: 'auto' }}"
     data-refresh-sections="{{ block.settings.refresh_sections | escape }}"
     data-gift-config="{{ app.metafields.gift.config.value | json | escape }}"
     style="{{ gift_style | strip_newlines }} display: none;"
></div>

<script type="application/json" data-gift-drawer-translations>
  {
    "promo_title": {{ promo_title | json }},
    "footnote": {{ 'gift.footnote' | t | json }},
    "available_gifts": {{ 'gift.drawer.available_gifts' | t | json }},
    "remaining": {{ 'gift.drawer.remaining' | t | json }},
    "loading": {{ 'gift.loading' | t | json }},
    "cta_choose": {{ cta_choose | json }},
    "cta_more": {{ cta_more | json }},
    "cta_manage": {{ cta_manage | json }},
    "label_unlock": {{ label_unlock | json }},
    "label_unlocked": {{ label_unlocked | json }},
    "label_used": {{ label_used | json }},
    "label_full": {{ label_full | json }}
  }
</script>

<script src="{{ 'gift-core.js' | asset_url }}" defer></script>
<script src="{{ 'gift-drawer.js' | asset_url }}" defer></script>
{{ 'gift-widget.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Gift Drawer Embed",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds the gift widget to the theme's cart drawer when the drawer doesn't support app blocks. Set the drawer selector if it isn't found automatically."
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Title",
      "info": "Leave empty to use the default translated text."
    },
    {
      "type": "checkbox",
      "id": "show_remaining",
      "label": "Show remaining gift budget",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "redirect_checkout",
      "label": "Send the drawer's checkout button to the cart page",
      "default": false,
      "info": "Lets customers choose their gift on the cart page before checking out."
    },
    {
      "type": "select",
      "id": "product_preview",
      "label": "Product preview",
      "options": [
        {
          "value": "disabled",
          "label": "Disabled"
        },
        {
          "value": "3",
          "label": "3 products"
        },
        {
          "value": "4",
          "label": "4 products"
        }
      ],
      "default": "disabled"
    },
    {
      "type": "text",
      "id": "drawer_selector",
      "label": "Cart drawer selector",
      "info": "Optional CSS selector of the theme's cart drawer. Detected automatically when empty."
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "Position in the drawer",
      "options": [
        {
          "value": "top",
          "label": "Above the cart items"
        },
        {
          "value": "bottom",
          "label": "Above the drawer footer"
        }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "cta_choose",
      "label": "Button — choose gifts"
    },
    {
      "type": "text",
      "id": "cta_more",
      "label": "Button — choose more"
    },
    {
      "type": "text",
      "id": "cta_manage",
      "label": "Button — manage gifts"
    },
    {
      "type": "text",
      "id": "label_unlock",
      "label": "Text — below threshold",
      "info": "Use [amount] for the remaining amount."
    },
    {
      "type": "text",
      "id": "label_unlocked",
      "label": "Text — budget unlocked",
      "info": "Use [budget] for the gift budget."
    },
    {
      "type": "text",
      "id": "label_used",
      "label": "Text — partly used",
      "info": "Use [amount] and [remaining]."
    },
    {
      "type": "text",
      "id": "label_full",
      "label": "Text — budget fully used"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "container_radius",
      "label": "Container corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave colors empty to follow the section's color scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border"
    },
    {
      "type": "checkbox",
      "id": "border_transparent",
      "label": "Transparent border",
      "default": false,
      "info": "Keeps the border's space but hides its color."
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Gift card background"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress bar"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight (gift budget, free prices)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "info": "Set to 0 for no border."
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Inner padding",
      "options": [
        {
          "value": "0.75",
          "label": "Compact"
        },
        {
          "value": "1.25",
          "label": "Default"
        },
        {
          "value": "2",
          "label": "Spacious"
        }
      ],
      "default": "1.25"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space above and below",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        {
          "value": "0.8125",
          "label": "Small"
        },
        {
          "value": "0.9375",
          "label": "Medium"
        },
        {
          "value": "1.125",
          "label": "Large"
        },
        {
          "value": "1.375",
          "label": "Extra large"
        }
      ],
      "default": "0.9375"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Uppercase title",
      "default": true
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "refresh_mode",
      "label": "Cart refresh after a gift change",
      "options": [
        {
          "value": "auto",
          "label": "Re-render cart sections (recommended)"
        },
        {
          "value": "events",
          "label": "Theme cart events only"
        },
        {
          "value": "reload",
          "label": "Reload the page"
        }
      ],
      "default": "auto",
      "info": "Choose \"Reload the page\" if the cart doesn't update after adding a gift on your theme."
    },
    {
      "type": "text",
      "id": "refresh_sections",
      "label": "Extra section IDs to refresh",
      "info": "Comma-separated section IDs the app should also re-render, e.g. header,cart-drawer."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/gift-threshold",
      "info": "Change only if you renamed the app proxy URL in Shopify admin."
    }
  ]
}
{% endschema %}
