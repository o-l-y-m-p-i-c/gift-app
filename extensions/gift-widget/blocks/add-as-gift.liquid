{% comment %}
  Add as Gift — App Block for product pages.
  Renders an "Add as gift" button next to the product form.
  Uses the shared gift-core.js runtime for eligibility and the BXGY workflow.

  Place via: Online Store → Customize → Product template → Add block → Add as gift
{% endcomment %}

{% assign btn_label = block.settings.button_label %}
{% if btn_label == blank %}{% assign btn_label = 'gift.product.button_label' | t %}{% endif %}
{% assign disabled_label = block.settings.disabled_label %}
{% if disabled_label == blank %}{% assign disabled_label = 'gift.product.disabled_label' | t %}{% endif %}
{% assign over_budget_label = block.settings.over_budget_label %}
{% if over_budget_label == blank %}{% assign over_budget_label = 'gift.product.over_budget_label' | t %}{% endif %}
{% assign unavailable_label = block.settings.unavailable_label %}
{% if unavailable_label == blank %}{% assign unavailable_label = 'gift.product.unavailable_label' | t %}{% endif %}
{% assign excluded_label = block.settings.excluded_label %}
{% if excluded_label == blank %}{% assign excluded_label = 'gift.product.excluded_label' | t %}{% endif %}
{% assign loading_label = block.settings.loading_label %}
{% if loading_label == blank %}{% assign loading_label = 'gift.product.loading_label' | t %}{% endif %}
{% assign error_label = block.settings.error_label %}
{% if error_label == blank %}{% assign error_label = 'gift.product.error_label' | t %}{% endif %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% capture align_style %}text-align: {{ block.settings.alignment }};{% endcapture %}

{%- capture gift_style -%}
  --gift-accent: {{ block.settings.accent_color | default: '#1c1c1c' }};
  --gift-accent-text: {{ block.settings.accent_text_color | default: '#ffffff' }};
  --gift-corner-radius: {{ block.settings.corner_radius | default: 12 }}px;
  --gift-custom-border-width: {{ block.settings.border_width | default: 1 }}px;
  --gift-padding-scale: {{ block.settings.padding | default: '1.25' }};
  --gift-custom-spacing: {{ block.settings.spacing | default: 16 }}px;
  --gift-title-scale: {{ block.settings.title_size | default: '0.9375' }};
  --gift-custom-title-transform: {% if block.settings.title_uppercase == false %}none{% else %}uppercase{% endif %};
  {%- if block.settings.background_color != blank %} --gift-custom-bg: {{ block.settings.background_color }};{% endif -%}
  {%- if block.settings.border_color != blank %} --gift-custom-border: {{ block.settings.border_color }};{% endif -%}
  {%- if block.settings.card_background_color != blank %} --gift-surface: {{ block.settings.card_background_color }};{% endif -%}
  {%- if block.settings.progress_color != blank %} --gift-custom-progress: {{ block.settings.progress_color }};{% endif -%}
  {%- if block.settings.highlight_color != blank %} --gift-custom-highlight: {{ block.settings.highlight_color }};{% endif -%}
  {%- if block.settings.text_color != blank %} color: {{ block.settings.text_color }};{% endif -%}
{%- endcapture -%}
{%- comment -%}
  Shared app attributes are written out here rather than rendered from a
  snippet: Shopify wraps app snippet output in HTML comments, which would
  close this tag early and print the attributes as text.
{%- endcomment -%}
<div id="add-as-gift-{{ block.id }}"
     class="add-as-gift {% if block.settings.full_width %}add-as-gift--full-width{% endif %}"
     data-gift-product-button
     data-product-id="{{ product.id }}"
     data-variant-id="{{ current_variant.id }}"
     data-variant-price="{{ current_variant.price }}"
     data-variant-available="{{ current_variant.available }}"
     data-product-form-selector="{{ block.settings.product_form_selector | escape }}"
     data-button-label="{{ btn_label | escape }}"
     data-disabled-label="{{ disabled_label | escape }}"
     data-over-budget-label="{{ over_budget_label | escape }}"
     data-unavailable-label="{{ unavailable_label | escape }}"
     data-excluded-label="{{ excluded_label | escape }}"
     data-loading-label="{{ loading_label | escape }}"
     data-error-label="{{ error_label | escape }}"
     data-show-remaining="{{ block.settings.show_remaining }}"
     data-gift-app
     data-shop="{{ shop.permanent_domain }}"
     data-shop-currency="{{ shop.currency }}"
     data-money-format="{{ shop.money_format | escape }}"
     data-proxy-path="{{ block.settings.proxy_path | default: '/apps/gift-threshold' | escape }}"
     data-refresh-mode="{{ block.settings.refresh_mode | default: 'auto' }}"
     data-refresh-sections="{{ block.settings.refresh_sections | escape }}"
     data-gift-config="{{ app.metafields.gift.config.value | json | escape }}"
     style="{{ gift_style | strip_newlines }} {{ align_style }}"
     {{ block.shopify_attributes }}
>
  <button type="button"
          class="add-as-gift__button {% if block.settings.button_style == 'secondary' %}add-as-gift__button--secondary{% else %}add-as-gift__button--primary{% endif %} {% if block.settings.full_width %}add-as-gift__button--full{% endif %}"
          disabled
          aria-live="polite">
    <span class="add-as-gift__label">{{ btn_label }}</span>
    <span class="add-as-gift__spinner" style="display:none;"></span>
  </button>

  <p class="add-as-gift__status" style="display:none;"></p>

  {% if block.settings.show_remaining %}
    <p class="add-as-gift__remaining" style="display:none;"></p>
  {% endif %}

  <script type="application/json" data-gift-product-variants>
    {{ product.variants | json }}
  </script>

  <script type="application/json" data-gift-product-translations>
    {
      "added": {{ 'gift.product.added' | t | json }},
      "remaining_budget": {{ 'gift.product.remaining_budget' | t | json }},
      "add_more": {{ 'gift.product.add_more' | t | json }},
      "promo_choice_title": {{ 'gift.promo_choice_title' | t | json }},
      "promo_choice_message": {{ 'gift.promo_choice_message' | t | json }},
      "promo_keep": {{ 'gift.promo_keep' | t | json }},
      "promo_use_gift": {{ 'gift.promo_use_gift' | t | json }}
    }
  </script>
</div>

<script src="{{ 'gift-core.js' | asset_url }}" defer></script>
<script src="{{ 'product-gift-button.js' | asset_url }}" defer></script>
{{ 'gift-widget.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Add as Gift",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds an \"Add as gift\" button to product pages. Customers can add the selected variant as a free gift when their cart reaches a gift tier and the price fits the remaining gift budget."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (eligible)"
    },
    {
      "type": "text",
      "id": "disabled_label",
      "label": "Label when no tier is active"
    },
    {
      "type": "text",
      "id": "over_budget_label",
      "label": "Label when the variant exceeds the remaining budget"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Label when the variant is unavailable"
    },
    {
      "type": "text",
      "id": "excluded_label",
      "label": "Label when the product is excluded from gifts"
    },
    {
      "type": "text",
      "id": "loading_label",
      "label": "Label while adding the gift"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Label on error"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make button full width",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_remaining",
      "label": "Show remaining gift budget",
      "default": true
    },
    {
      "type": "text",
      "id": "product_form_selector",
      "label": "Product form selector",
      "info": "Optional CSS selector of the theme's add-to-cart form, used to read the selected variant. Detected automatically when empty."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to follow the section's color scheme."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Gift card background"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress bar"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight (gift budget, free prices)"
    },
    {
      "type": "header",
      "content": "Border and spacing"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "info": "Set to 0 for no border."
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Inner padding",
      "options": [
        {
          "value": "0.75",
          "label": "Compact"
        },
        {
          "value": "1.25",
          "label": "Default"
        },
        {
          "value": "2",
          "label": "Spacious"
        }
      ],
      "default": "1.25"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space above and below",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        {
          "value": "0.8125",
          "label": "Small"
        },
        {
          "value": "0.9375",
          "label": "Medium"
        },
        {
          "value": "1.125",
          "label": "Large"
        },
        {
          "value": "1.375",
          "label": "Extra large"
        }
      ],
      "default": "0.9375"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Uppercase title",
      "default": true
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "refresh_mode",
      "label": "Cart refresh after a gift change",
      "options": [
        {
          "value": "auto",
          "label": "Re-render cart sections (recommended)"
        },
        {
          "value": "events",
          "label": "Theme cart events only"
        },
        {
          "value": "reload",
          "label": "Reload the page"
        }
      ],
      "default": "auto",
      "info": "Choose \"Reload the page\" if the cart doesn't update after adding a gift on your theme."
    },
    {
      "type": "text",
      "id": "refresh_sections",
      "label": "Extra section IDs to refresh",
      "info": "Comma-separated section IDs the app should also re-render, e.g. header,cart-drawer."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/gift-threshold",
      "info": "Change only if you renamed the app proxy URL in Shopify admin."
    }
  ]
}
{% endschema %}
