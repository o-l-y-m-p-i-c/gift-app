{% comment %}
  Gift Widget — App Block for the cart page.
  Shows available gifts when the cart reaches a configured threshold.
  Colors follow the section's color scheme; the button color, corner radius
  and cart refresh behaviour are set in the block settings.

  Place via: Online Store → Customize → Cart → Add block → Gift Widget
{% endcomment %}

{% assign promo_title = block.settings.promo_title %}
{% if promo_title == blank %}{% assign promo_title = 'gift.promo_title' | t %}{% endif %}
{% assign footnote = block.settings.footnote %}
{% assign gift_config = app.metafields.gift.config.value %}
{% assign gift_hidden = false %}
{% if gift_config and gift_config.settings.active == false %}{% assign gift_hidden = true %}{% endif %}
{% if gift_config and gift_config.tiers.size == 0 %}{% assign gift_hidden = true %}{% endif %}
{% if footnote == blank %}{% assign footnote = 'gift.footnote' | t %}{% endif %}

{%- capture gift_style -%}
  --gift-accent: {{ block.settings.accent_color | default: '#1c1c1c' }};
  --gift-accent-text: {{ block.settings.accent_text_color | default: '#ffffff' }};
  --gift-corner-radius: {{ block.settings.corner_radius | default: 12 }}px;
  --gift-custom-container-radius: {{ block.settings.container_radius | default: 12 }}px;
  --gift-custom-border-width: {{ block.settings.border_width | default: 1 }}px;
  --gift-padding-scale: {{ block.settings.padding | default: '1.25' }};
  --gift-custom-spacing: {{ block.settings.spacing | default: 16 }}px;
  --gift-title-scale: {{ block.settings.title_size | default: '0.9375' }};
  --gift-custom-title-transform: {% if block.settings.title_uppercase == false %}none{% else %}uppercase{% endif %};
  {%- if block.settings.background_color != blank %} --gift-custom-bg: {{ block.settings.background_color }};{% endif -%}
  {%- if block.settings.border_transparent %} --gift-custom-border: transparent;{% elsif block.settings.border_color != blank %} --gift-custom-border: {{ block.settings.border_color }};{% endif -%}
  {%- if block.settings.card_background_color != blank %} --gift-surface: {{ block.settings.card_background_color }};{% endif -%}
  {%- if block.settings.progress_color != blank %} --gift-custom-progress: {{ block.settings.progress_color }};{% endif -%}
  {%- if block.settings.highlight_color != blank %} --gift-custom-highlight: {{ block.settings.highlight_color }};{% endif -%}
  {%- if block.settings.text_color != blank %} color: {{ block.settings.text_color }};{% endif -%}
{%- endcapture -%}
{%- comment -%}
  Shared app attributes are written out here rather than rendered from a
  snippet: Shopify wraps app snippet output in HTML comments, which would
  close this tag early and print the attributes as text.
{%- endcomment -%}
<div id="gift-widget-{{ block.id }}"
     class="gift-widget-container"
     data-gift-widget
     data-hide-cart-until-chosen="{{ block.settings.hide_cart_until_chosen }}"
     data-main-cart-selector="{{ block.settings.main_cart_selector | escape }}"
     data-gift-app
     data-shop="{{ shop.permanent_domain }}"
     data-shop-currency="{{ shop.currency }}"
     data-money-format="{{ shop.money_format | escape }}"
     data-proxy-path="{{ block.settings.proxy_path | default: '/apps/gift-threshold' | escape }}"
     data-refresh-mode="{{ block.settings.refresh_mode | default: 'auto' }}"
     data-refresh-sections="{{ block.settings.refresh_sections | escape }}"
     data-gift-config="{{ app.metafields.gift.config.value | json | escape }}"
     style="{{ gift_style | strip_newlines }}"
     {{ block.shopify_attributes }}
>
  {%- comment -%}
    Skeleton shaped like the loaded widget so the page doesn't jump. Nothing
    is rendered when the app is turned off or has no tiers.
  {%- endcomment -%}
  {%- unless gift_hidden -%}
    <div class="gift-widget gift-widget--loading" aria-busy="true" aria-label="{{ 'gift.loading' | t | escape }}">
      <div class="gift-widget__skeleton-line gift-widget__skeleton-line--title"></div>
      <div class="gift-widget__skeleton-line gift-widget__skeleton-line--subtitle"></div>
      <div class="gift-widget__loading-scale">
        <div class="gift-widget__skeleton-line gift-widget__skeleton-line--scale"></div>
      </div>
      <div class="gift-widget__carousel gift-widget__carousel--loading">
        {%- for i in (1..3) -%}
          <div class="gift-widget__card gift-widget__card--skeleton">
            <div class="gift-widget__skeleton-image"></div>
            <div class="gift-widget__info">
              <div class="gift-widget__skeleton-line gift-widget__skeleton-line--name"></div>
              <div class="gift-widget__skeleton-line gift-widget__skeleton-line--price"></div>
            </div>
            <div class="gift-widget__skeleton-button"></div>
          </div>
        {%- endfor -%}
      </div>
      <div class="gift-widget__skeleton-line gift-widget__skeleton-line--text"></div>
    </div>
  {%- endunless -%}
</div>

<script type="application/json" data-gift-translations>
  {
    "promo_title": {{ promo_title | json }},
    "footnote": {{ footnote | json }},
    "loading": {{ 'gift.loading' | t | json }},
    "error_title": {{ 'gift.error_title' | t | json }},
    "retry": {{ 'gift.retry' | t | json }},
    "select": {{ 'gift.select' | t | json }},
    "remove": {{ 'gift.remove' | t | json }},
    "gift_budget": {{ 'gift.gift_budget' | t | json }},
    "gift_budget_max": {{ 'gift.gift_budget_max' | t | json }},
    "to_unlock_next": {{ 'gift.to_unlock_next' | t | json }},
    "to_unlock_first": {{ 'gift.to_unlock_first' | t | json }},
    "unlock_more": {{ 'gift.unlock_more' | t | json }},
    "budget_full": {{ 'gift.budget_full' | t | json }},
    "unable_load": {{ 'gift.unable_load' | t | json }},
    "no_products": {{ 'gift.no_products' | t | json }},
    "choose_up_to": {{ 'gift.choose_up_to' | t | json }},
    "remaining": {{ 'gift.remaining' | t | json }},
    "budget_label": {{ 'gift.budget_label' | t | json }},
    "unlock_free": {{ 'gift.unlock_free' | t | json }},
    "skip_step": {{ 'gift.skip_step' | t | json }},
    "promo_conflict": {{ 'gift.promo_conflict' | t | json }},
    "promo_choice_title": {{ 'gift.promo_choice_title' | t | json }},
    "promo_choice_message": {{ 'gift.promo_choice_message' | t | json }},
    "promo_keep": {{ 'gift.promo_keep' | t | json }},
    "promo_use_gift": {{ 'gift.promo_use_gift' | t | json }},
    "notif_tier_unlocked": {{ 'gift.notifications.tier_unlocked' | t | json }},
    "notif_removed_discount": {{ 'gift.notifications.removed_discount' | t | json }},
    "notif_removed_no_qualify": {{ 'gift.notifications.removed_no_qualify' | t | json }},
    "notif_removed_choose_again": {{ 'gift.notifications.removed_choose_again' | t | json }},
    "notif_add_failed": {{ 'gift.notifications.add_failed' | t | json }},
    "notif_remove_failed": {{ 'gift.notifications.remove_failed' | t | json }}
  }
</script>

<script src="{{ 'gift-core.js' | asset_url }}" defer></script>
<script src="{{ 'gift-widget.js' | asset_url }}" defer></script>
{{ 'gift-widget.css' | asset_url | stylesheet_tag }}

{%- if block.settings.custom_css != blank -%}
  {%- comment -%}
    Nested under this block's ID so the CSS only affects this widget.
    "</" is neutralised so the code can't close the style tag.
  {%- endcomment -%}
  <style>
    #gift-widget-{{ block.id }} {
      {{ block.settings.custom_css | replace: '</', '<\/' }}
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Gift Widget",
  "target": "section",
  "enabled_on": {
    "templates": [
      "cart"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a free gift selector when the cart reaches a gift tier. Configure tiers in the Gift Threshold app."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Title",
      "info": "Leave empty to use the default translated text."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "info": "Leave empty to use the default translated text."
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "hide_cart_until_chosen",
      "label": "Hide the cart until a gift is chosen",
      "default": false,
      "info": "Shows the gift selector first, with a button to skip to the cart."
    },
    {
      "type": "text",
      "id": "main_cart_selector",
      "label": "Cart section selector",
      "info": "Optional CSS selector of the cart section to hide. Detected automatically when empty."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "container_radius",
      "label": "Container corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave colors empty to follow the section's color scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border"
    },
    {
      "type": "checkbox",
      "id": "border_transparent",
      "label": "Transparent border",
      "default": false,
      "info": "Keeps the border's space but hides its color."
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Gift card background"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress bar"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight (gift budget, free prices)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "info": "Set to 0 for no border."
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Inner padding",
      "options": [
        {
          "value": "0.75",
          "label": "Compact"
        },
        {
          "value": "1.25",
          "label": "Default"
        },
        {
          "value": "2",
          "label": "Spacious"
        }
      ],
      "default": "1.25"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space above and below",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        {
          "value": "0.8125",
          "label": "Small"
        },
        {
          "value": "0.9375",
          "label": "Medium"
        },
        {
          "value": "1.125",
          "label": "Large"
        },
        {
          "value": "1.375",
          "label": "Extra large"
        }
      ],
      "default": "0.9375"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Uppercase title",
      "default": true
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "refresh_mode",
      "label": "Cart refresh after a gift change",
      "options": [
        {
          "value": "auto",
          "label": "Re-render cart sections (recommended)"
        },
        {
          "value": "events",
          "label": "Theme cart events only"
        },
        {
          "value": "reload",
          "label": "Reload the page"
        }
      ],
      "default": "auto",
      "info": "Choose \"Reload the page\" if the cart doesn't update after adding a gift on your theme."
    },
    {
      "type": "text",
      "id": "refresh_sections",
      "label": "Extra section IDs to refresh",
      "info": "Comma-separated section IDs the app should also re-render, e.g. header,cart-drawer."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/gift-threshold",
      "info": "Change only if you renamed the app proxy URL in Shopify admin."
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Applies to this widget only. Example: .gift-widget__promo-title { color: #b5651d; } or .gift-widget { box-shadow: none; }"
    }
  ]
}
{% endschema %}
