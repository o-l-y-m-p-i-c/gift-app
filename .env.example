# App
PORT=3000
NODE_ENV=development

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Shopify App credentials (replace with values from Partner Dashboard)
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-app-url.ngrok.io

# Static Admin API access token (from Shopify Admin → Apps → [app] → App setup → Admin API integration)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Scopes
SCOPES=read_products,write_products,read_orders,read_discounts,write_discounts,write_app_proxy

# Webhook secret (for verifying webhook signatures)
WEBHOOK_SECRET=your_webhook_secret
