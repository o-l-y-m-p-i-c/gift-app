# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# DATABASE_URL is used by the app; with Neon, use the pooled "-pooler" host.
# DIRECT_URL is used for migrations and must skip the pooler (Neon: the same
# host without "-pooler"). Without a pooler, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gift_app"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gift_app"

# Shopify app credentials (Partner Dashboard → your app → Client credentials)
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
SHOPIFY_APP_URL=https://your-app-host.example.com

# Scopes (must match shopify.app.toml)
SCOPES=read_products,read_discounts,write_discounts,read_orders

# Support address shown on the public privacy policy page (/privacy)
SUPPORT_EMAIL=support@example.com

# Billing plan (defaults shown). Shopify charges every 30 days.
BILLING_PLAN_NAME="Gift App Pro"
BILLING_PLAN_PRICE=9.99
BILLING_PLAN_CURRENCY=USD
BILLING_TRIAL_DAYS=14

# Billing: create Shopify test charges instead of real ones (staging only).
# Development stores are always free and never charged.
SHOPIFY_BILLING_TEST=false
