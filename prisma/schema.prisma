// Prisma schema for Gift Threshold App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the running app.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations: Prisma's migration lock
  // doesn't work through a connection pooler such as Neon's PgBouncer.
  directUrl = env("DIRECT_URL")
}

// Shopify OAuth sessions (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id               String   @id
  shop             String
  state            String
  isOnline         Boolean  @default(false)
  scope            String?
  expires          DateTime?
  expiresAt        DateTime?
  accessToken      String
  userId           BigInt?
  firstName        String?
  lastName         String?
  email            String?
  accountOwner     Boolean?
  locale           String?
  collaborator     Boolean?
  emailVerified    Boolean?
  onlineAccessInfo Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop])
}

// Legacy gift tiers. Tiers now live in the $app:gift_tier metaobject; rows here
// are only read once per shop to migrate them (AppSettings.tiersMigratedAt).
model GiftTier {
  id           Int      @id @default(autoincrement())
  shopId       String
  minAmount    Int      // in cents of the shop currency (AppSettings.currencyCode)
  giftPercent  Float    // e.g., 5.00 means 5%
  giftAmount   Int      // in cents — pre-calculated max gift price
  collectionId String?  // Shopify collection GID (null = all products)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId])
  @@unique([shopId, minAmount])
}

// App settings per shop
model AppSettings {
  id                       Int      @id @default(autoincrement())
  shopId                   String   @unique
  useTotalAfterDiscounts   Boolean  @default(true)
  showLevelUpNotification  Boolean  @default(true)
  showRemovalNotification  Boolean  @default(true)
  active                   Boolean  @default(true)
  excludedCollections      String[] @default([])
  excludedTags             String[] @default([])
  currencyCode             String   @default("USD") // shop currency; tier amounts use it
  tiersMigratedAt          DateTime? // legacy GiftTier rows copied to metaobjects
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Gift history — records of gifts given
model GiftHistory {
  id                Int      @id @default(autoincrement())
  shopId            String
  orderId           String
  tierId            String   // gift_tier metaobject GID (older rows: legacy GiftTier id)
  giftProductId     String
  giftProductTitle  String
  giftProductPrice  Int      // in cents
  giftProductImage  String?
  cartTotal         Int      // in cents
  thresholdBase     Int      // in cents — amount used for threshold calculation
  createdAt         DateTime @default(now())

  @@index([shopId])
  @@index([orderId])
}

// Billing state per shop — cached so storefront requests can check access
// without calling the Shopify Admin API.
model ShopBilling {
  id                 Int       @id @default(autoincrement())
  shopId             String    @unique
  trialStartedAt     DateTime  @default(now()) // kept across reinstalls so the trial is used once
  isDevStore         Boolean   @default(false)
  subscriptionId     String?   // active Shopify AppSubscription GID
  subscriptionStatus String?   // ACTIVE | PENDING | CANCELLED | ...
  currentPeriodEnd   DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Trial start per shop. Unlike ShopBilling it survives shop/redact, so
// reinstalling the app doesn't grant a second free trial.
model ShopTrial {
  shopId         String   @id
  trialStartedAt DateTime @default(now())
  devStore       Boolean  @default(false) // last known development-store status
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Single-use gift discount codes created for the storefront, deleted once expired
model GiftDiscount {
  id        String   @id // DiscountCodeNode GID
  shopId    String
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([shopId, endsAt])
}

// Shopify app subscriptions (charges) the shop has created
model BillingSubscription {
  id               String    @id // Shopify AppSubscription GID
  shopId           String
  name             String
  status           String
  test             Boolean   @default(false)
  trialDays        Int       @default(0)
  amount           Int       // in cents
  currencyCode     String
  createdAt        DateTime
  currentPeriodEnd DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([shopId])
}

// Recurring payments, one per paid 30-day billing cycle
model BillingPayment {
  id             Int      @id @default(autoincrement())
  shopId         String
  subscriptionId String
  amount         Int      // in cents
  currencyCode   String
  periodStart    DateTime
  periodEnd      DateTime
  test           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([shopId])
  @@unique([subscriptionId, periodStart])
}
